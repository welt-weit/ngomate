{
	"name": "ngomate",
	"license": "MIT",
	"private": true,
	"type": "module",
	"packageManager": "yarn@4.12.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "yarn workspace @ngomate/core build",
		"typecheck": "yarn workspaces foreach -A run typecheck",
		"lint": "biome lint ./packages",
		"test": "vitest run",
		"ngomate": "yarn workspace @ngomate/cli run ngomate"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"typescript": "~5.7.0",
		"vitest": "^4.1.2"
	}
}
