{
	"name": "ngomate",
	"license": "MIT",
	"private": true,
	"type": "module",
	"packageManager": "yarn@4.12.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"build": "yarn workspaces foreach -At --include '@ngomate/core' --include '@ngomate/ui' --include '@ngomate/tauri' run build",
		"desktop": "yarn workspace @ngomate/desktop tauri dev",
		"storybook": "yarn workspace @ngomate/ui storybook",
		"typecheck": "yarn workspaces foreach -A run typecheck",
		"lint": "biome lint ./packages ./apps ./scripts",
		"test": "vitest run",
		"ngomate": "yarn workspace @ngomate/cli run ngomate",
		"bump:patch": "node scripts/bump-version.mjs patch",
		"bump:minor": "node scripts/bump-version.mjs minor",
		"bump:major": "node scripts/bump-version.mjs major",
		"release": "node scripts/release.mjs cut",
		"release:check": "node scripts/release.mjs check",
		"release:publish": "node scripts/release.mjs publish"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"typescript": "~5.7.0",
		"vitest": "^4.1.2"
	}
}
