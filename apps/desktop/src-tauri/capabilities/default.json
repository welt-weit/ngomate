{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "The main window",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"ngomate:default",
		"opener:allow-open-url",
		{
			"identifier": "http:default",
			"allow": [
				{ "url": "http://127.0.0.1:*" },
				{ "url": "http://localhost:*" },
				{ "url": "https://*:*" },
				{ "url": "http://*:*" }
			]
		}
	]
}
